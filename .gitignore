# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lint_output.txt

# local env files (never commit secrets — keep only .env.example)
.env
.env*.local
.env.production
.env.development
!.env.example

# prisma local database
/prisma/*.db
/prisma/*.db-journal

# user uploads (runtime data, not source)
/public/uploads/photos/*
!/public/uploads/photos/.gitkeep

# vercel / netlify
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch, test fixtures and local plans
/tmp
/temp-prisma
/*.pdf
/docs/plans
/docs/superpowers

# artefactos generados por los scripts de verificacion
/scripts/.build
/scripts/.out
/scripts/shots

# local editor / agent tooling
/.freebuff
/.zcode
/.interface-design
/.vscode
