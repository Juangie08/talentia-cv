# Talentia — plantilla de variables de entorno.
# Copia este archivo a .env (local) o configúralas en tu proveedor de hosting.
# NUNCA subas el .env real al repositorio: contiene secretos.

# --- Proyecto open source (públicas; aparecen en la interfaz) ---
# URL de tu repositorio o fork: de aquí salen los enlaces de GitHub,
# licencia, "contribuir" y reporte de issues.
NEXT_PUBLIC_GITHUB_URL="https://github.com/talentia-hdv/talentia"
# URL canónica del sitio (metadata, Open Graph, enlaces absolutos).
NEXT_PUBLIC_SITE_URL="http://localhost:3500"

# --- Sin cuentas ni base de datos ---
# Talentia funciona sin registro: cada persona guarda su hoja de vida en el
# navegador. No hace falta DATABASE_URL ni servicio de autenticación.

# --- IA (cualquier endpoint compatible con la API de OpenAI) ---
# Sin clave, la app sigue funcionando con los respaldos locales.
# La clave y la URL viven SOLO en el servidor: nunca las pongas en una
# variable NEXT_PUBLIC_ ni las subas al repositorio.
AI_API_KEY=""
AI_BASE_URL=""
# "auto" deja que el endpoint elija el mejor modelo disponible.
AI_MODEL="auto"
# Modelo multimodal (visión) para leer PDFs escaneados o fotos de hojas de vida.
AI_VISION_MODEL="auto"
# Tiempo máximo de espera por respuesta, en milisegundos.
AI_TIMEOUT_MS="90000"
# Modo de prueba: "1" responde con datos de ejemplo deterministas, sin clave
# ni créditos. Ideal para probar el producto completo y para el CI.
AI_MOCK=""

# --- Antiabuso de la IA (protege la clave del servidor) ---
# No hay cuota diaria: el único límite es por IP y por minuto.
AI_REQUESTS_PER_MINUTE="15"
